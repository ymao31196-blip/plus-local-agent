{
  "schema_version": 1,
  "id": "qmd",
  "autostart": false,
  "mode": "auto",
  "routing_authority": "recommendation",
  "runtime": {
    "kind": "executable_stdio",
    "command": "node.exe",
    "args": [
      "node_modules/@tobilu/qmd/dist/cli/qmd.js",
      "mcp"
    ],
    "cwd": ".provider_envs/qmd",
    "discovery_timeout_seconds": 45,
    "invoke_timeout_seconds": 90
  },
  "tool_allowlist": [
    "status"
  ],
  "tool_overrides": {
    "status": {
      "title": "QMD Engine Status",
      "description": "Optional native QMD status for the component's own default index; use PLA core.workspace_index_* for authorized project indexes.",
      "risk_level": "read",
      "requires_confirmation": false,
      "tags": [
        "qmd",
        "index",
        "status"
      ]
    }
  }
}
