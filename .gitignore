# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/
.provider_envs/
.observer_envs/
.browser_profiles/
observer_manifests/*.local.json
config/tunnel.local.yaml

# Local secrets and credentials
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.secret
*credential*
*credentials*
*tunnel-token*
*tunnel-secret*

# IDE and editor state
.vscode/
.idea/
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp
*.temp
cache/
caches/
tmp/
temp/

# Build and packaging output
dist/
build/
*.egg-info/

# Runtime workspace output; preserve only the reproducible ChatGPT E2E fixture.
workspace/*
!workspace/agent_test/
workspace/agent_test/*
!workspace/agent_test/calculator.py
!workspace/agent_test/test_calculator.py

# Durable runtime records (not user workspace data)
state/
